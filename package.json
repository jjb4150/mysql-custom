{
  "name": "mysql-custom",
  "displayName": "MySQL Custom",
  "description": "MySQL/MariaDB client with enhanced SQL intellisense (based on cweijan/vscode-database-client 3.9.8, MIT)",
  "version": "0.1.0",
  "publisher": "junbiaojin",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.51.0"
  },
  "categories": [
    "Programming Languages",
    "Keymaps"
  ],
  "keywords": [
    "SQL",
    "MySQL",
    "Database",
    "Postgresql"
  ],
  "homepage": "https://github.com/jjb4150/mysql-custom#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjb4150/mysql-custom.git"
  },
  "activationEvents": [
    "onCommand:mysql.connection.add",
    "onCommand:mysql.refresh",
    "onView:github.junbiaojin.mysql"
  ],
  "main": "./out/extension",
  "contributes": {
    "languages": [
      {
        "id": "sql",
        "extensions": [
          ".sql",
          ".dsql"
        ],
        "aliases": [
          "SQL"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "sql",
        "path": "./syntaxes/snippets.json"
      }
    ],
    "grammars": [
      {
        "language": "sql",
        "scopeName": "source.sql",
        "path": "./syntaxes/mysql.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "github-junbiaojin-mysql",
          "title": "Database",
          "icon": "resources/icon/database-container.svg"
        }
      ]
    },
    "views": {
      "github-junbiaojin-mysql": [
        {
          "id": "github.junbiaojin.mysql",
          "name": "Database"
        }
      ]
    },
