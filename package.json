    "keybindings": [
      {
        "command": "mysql.runQuery",
        "key": "f9",
        "when": "editorLangId == sql"
      },
      {
        "command": "mysql.runQuery",
        "key": "ctrl+enter",
        "when": "editorLangId == sql"
      },
      {
        "command": "mysql.runAllQuery",
        "key": "ctrl+f9",
        "when": "editorLangId == sql"
      },
      {
        "command": "mysql.runAllQuery",
        "key": "ctrl+shift+enter",
        "when": "editorLangId == sql"
      },
      {
        "command": "mysql.mock.run",
        "when": "resourceFilename =~ /mock\\.json$/ ",
        "key": "f9"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mysql.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation@-2"
        },
        {
          "command": "mysql.runAllQuery",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "mysql.db.active",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "mysql.runQuery",
          "when": "editorLangId == sql || resourceFilename =~ /.sql$/ ",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mysql.connection.add",
          "when": "view =~ /junbiaojin.+?ql/",
          "group": "navigation@3"
        },
        {
          "command": "mysql.refresh",
          "when": "view =~ /junbiaojin.+?ql/",
          "group": "navigation@2"
        },
        {
          "command": "mysql.history.open",
          "when": "view == github.junbiaojin.mysql",
          "group": "navigation@0"
        },
        {
          "command": "mysql.connection.config",
          "when": "view =~ /junbiaojin.+?ql/",
          "group": "navigation@-3"
        }
      ],
      "view/item/context": [
        {
          "command": "mysql.refresh",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem =~ /^(catalog|connection|tableGroup|viewGroup|systemViewGroup|triggerGroup|procedureGroup|functionGroup|table)$/",
          "group": "inline@-2"
        },
        {
          "command": "mysql.connection.edit",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem =~ /^(connection)$/",
          "group": "1_mysql@2"
        },
        {
          "command": "mysql.connection.disable",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem =~ /^(connection)$/",
          "group": "1_mysql@4"
        },
        {
          "command": "mysql.host.copy",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem =~ /^(connection)$/",
          "group": "1_mysql@6"
        },
        {
          "command": "mysql.database.add",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem == connection",
          "group": "2_mysql@0"
        },
        {
          "command": "mysql.query.add",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem == queryGroup",
          "group": "2_mysql@0"
        },
        {
          "command": "mysql.query.rename",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem == query",
          "group": "2_mysql@0"
        },
        {
          "command": "mysql.query.run",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem == query",
          "group": "2_mysql@0"
        },
        {
          "command": "mysql.server.info",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem == connection",
          "group": "4_mysql@1"
        },
        {
          "command": "mysql.data.import",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem == connection",
          "group": "8_mysql@1"
        },
        {
          "command": "mysql.connection.delete",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem =~ /^(connection)$/",
          "group": "10mysql@2"
        },
        {
          "command": "mysql.database.add",
          "when": "view =~ /junbiaojin.+?ql/ && viewItem == connection",
          "group": "inline@0"
        },
        {
          "command": "mysql.connection.terminal",
