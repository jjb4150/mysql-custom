    "configuration": {
      "type": "object",
      "title": "%config.title%",
      "properties": {
        "database-client.defaultSelectLimit": {
          "type": "integer",
          "default": 100,
          "description": "%config.defaultSelectLimit%"
        },
        "database-client.highlightSQLBlock": {
          "type": "boolean",
          "default": false,
          "description": "Highlight SQL Code block."
        },
        "database-client.preferConnectionName": {
          "type": "boolean",
          "default": true,
          "description": "%config.preferConnectionName%"
        },
        "database-client.disableSqlCodeLen": {
          "type": "boolean",
          "default": false,
          "description": "Disable Sql Code lens."
        },
        "database-client.resultInSplitView": {
          "type": "boolean",
          "default": false,
          "description": "Open query result in a split editor group on the right. Default false: result opens below, in the same editor group."
        },
        "database-client.showColumnComment": {
          "type": "boolean",
          "default": true,
          "description": "Show column comment in result view header."
        },
        "database-client.keepResultHistory": {
          "type": "boolean",
          "default": true,
          "description": "Keep one result panel per execution. Default true: previous query results stay open, like Navicat."
        },
        "database-client.singleResultPanel": {
          "type": "boolean",
          "default": true,
          "description": "Use one result panel with multiple result tabs. Default true: each query opens a new tab inside the same panel, like Navicat/DMS."
        },
        "database-client.resultBelowEditor": {
          "type": "boolean",
          "default": true,
          "description": "Open the result panel below the SQL editor (vertical split). Default true."
        },
        "database-client.autoPagingSQL": {
          "type": "boolean",
          "default": true,
          "description": "Automatically add LIMIT to SELECT statements on first execution. Prevents pulling whole table into memory."
        },
        "database-client.exportRowLimit": {
          "type": "integer",
          "default": 500000,
          "description": "Row count warning threshold for full data export. Export asks for confirmation when exceeding it."
        },
        "database-client.countTimeout": {
          "type": "integer",
          "default": 3000,
          "description": "Max execution time in milliseconds for the total-count query. Prevents slow SQL on large tables."
        },
        "database-client.autoCountTotal": {
          "type": "boolean",
          "default": false,
          "description": "Automatically count total rows after each query. Default false: click the Total button to count on demand, avoiding slow SQL on large tables."
        },
        "database-client.autoUseActiveDatabase": {
          "type": "boolean",
          "default": true,
          "description": "Automatically use the active database when running SQL without an explicit database prefix."
        },
        "database-client.showUser": {
          "type": "boolean",
          "default": false,
          "description": "Show user on tree view."
        },
        "database-client.showView": {
          "type": "boolean",
          "default": true,
          "description": "Show view on tree view."
        },
        "database-client.showQuery": {
          "type": "boolean",
          "default": false,
          "description": "Show query on tree view."
        },
        "database-client.showProcedure": {
          "type": "boolean",
          "default": true,
          "description": "Show procedure on tree view."
        },
        "database-client.showFunction": {
          "type": "boolean",
          "default": true,
          "description": "Show function on tree view."
        },
        "database-client.showTrigger": {
          "type": "boolean",
          "default": false,
          "description": "Show trigger on tree view."
        }
      }
    }
  },
